#!/usr/bin/env bash
# Fake `gh` for scripts/po tests. Records every invocation to $FAKE_GH_LOG (one line per call,
# args separated by a tab) and answers via the `handle` function defined in $FAKE_GH_HANDLER.
# Handlers return what the real API would (JSON); a `-q/--jq <expr>` argument is applied with
# the real `jq -r`, as `gh` does, so scripts and tests agree on one contract.
set -euo pipefail
line=$(IFS=$'\t'; echo "$*")
printf '%s\n' "${line//$'\n'/ }" >> "$FAKE_GH_LOG"   # multi-line args (GraphQL) stay on one log line
# shellcheck source=/dev/null
source "$FAKE_GH_HANDLER"

# #392 で足した読み取り専用の2つの問い合わせは**どのテストの経路でも通る**ので、
# ハンドラが答えなかった場合の既定をここに置く（15 個のハンドラ全部に同じ節を書き足さない）。
# 既定は「何も起きていない」側:
#   - このブランチを base にした open PR は無い（空リスト）
#   - HEAD は動いていない（起動時に読んだ値をそのまま返す。既定は "oid1"）
# **その2つを検査するテストはハンドラ側で明示的に上書きする**（handle が先に見られる）。
# 既定が検査を素通しさせていないことは、上書きしたテストが落ちることで確かめている。
#
# #1006 でレビュー済みの検査が増え、これも**どのテストの経路でも通る**ので既定を置く。
# 既定は同じく「何も起きていない」側＝**レビューは済んでいる**（他の関心事を試している
# 30 個のテストを、レビューの話で落とさない）。
# **「既定が検査を素通しさせている」形にならないこと**は、
# **`[]` に上書きしたテスト（1006: レビューの報告が無い PR はマージしない）が
# 止まることで確かめている**——既定が効いてしまうなら、そのテストは通らない。
handle_with_defaults() {
  local rc=0 err
  # handle は `exit 99` で知らない呼び出しを知らせるので、**サブシェルで**呼ぶ
  # （そのままだとこの fake gh 自体が終了して、既定に回らない）
  set +e
  ( handle "$@" ) 2>"$FAKE_UNHANDLED"
  rc=$?
  set -e
  [[ "$rc" == 0 ]] && return 0
  err=$(cat "$FAKE_UNHANDLED")
  # ハンドラが「知らない呼び出し」として落ちたときだけ既定に回す。
  # 本物の失敗（exit 1 / 8 など）はそのまま通す
  if [[ "$rc" == 99 && "$err" == unexpected:* ]]; then
    case "$*" in
      "pr list --repo "*" --base "*" --state open --json number"*) echo '[]'; return 0 ;;
      "pr view "*"--json headRefOid"*) echo '{"headRefOid":"oid1"}'; return 0 ;;
      "api repos/"*"/issues/"*"/comments"*) echo '[{"user":{"login":"uonoko1"},"body":"## レビュー: マージしてよい"}]'; return 0 ;;
      # #1101 で枝のコミットの身元の検査が増え、これも**どのテストの経路でも通る**ので既定を置く。
      # 既定は同じく「何も起きていない」側＝**本人確認済みのアドレスでコミットされている**
      # （他の関心事を試しているテストを、身元の話で落とさない）。
      # **本物の API と同じ JSON を返す**（上の `--jq` が本物の jq で評価するので、
      # 形が違えば落ちる——**`parents` を持たない形にすると `select` が通らない**）。
      # **「既定が検査を素通しさせている」形にならないこと**は、
      # **誤った数字 ID に上書きしたテストが止まることで確かめている**（#1101 の 3 本）。
      "api repos/"*"/pulls/"*"/commits"*)
        echo '[{"parents":[{"sha":"p1"}],"commit":{"author":{"email":"120390190+uonoko1@users.noreply.github.com"},"committer":{"email":"120390190+uonoko1@users.noreply.github.com"}}}]'
        return 0 ;;
    esac
  fi
  [[ -n "$err" ]] && printf '%s\n' "$err" >&2
  return "$rc"
}

JQ=""
prev=""
for a in "$@"; do
  if [[ "$prev" == "-q" || "$prev" == "--jq" ]]; then JQ=$a; fi
  prev=$a
done

# ---- ページングを真似る（#1157）-------------------------------------------------------------
# **何が壊れていたか**: **この fake は `--paginate` を 1 度も見ていなかった。**
# **だから `merge-when-green.sh` から `--paginate` を落としても、この fake は全件を返し続け、
# 143 本すべてが緑のままだった**（#1151 のレビュアーの実測）。
# **本物の穴は check-runs 側で実際に起きている**（#1093: 30/53 で必須 5 件が消えた）。
#
# **本物の `gh api` の振る舞い**（#1093 で実測。gh 2.89.0）:
#   - **`per_page` を指定しないと 1 ページ 30 件**で切れる。
#   - **`--paginate` を付けると gh が `per_page` に 100 を補い、全ページを取る。**
#
# **だからここでは「`--paginate` が無ければ配列を先頭 30 件で切る」**。
# **`total_count` は切らない**——**本物も切らない**（どのページも同じ母数を返す）。
# **これが「母数は在るのに手元が足りない」＝ #1093 の形そのものである。**
#
# **配列そのもの（`pulls/<n>/commits`）と、オブジェクトの中の配列
# （`check-runs` の `.check_runs`）の両方を切る**——**この道具はどちらも読む。**
# **30 件以下の応答は 1 バイトも変わらない**ので、既存の 226 本には影響しない
# （実測: いま在る fixture の最大は 3 件）。
FAKE_PER_PAGE=${FAKE_PER_PAGE:-30}
paginate_emulate() {
  local body=$1 paginated=$2
  [[ "$paginated" == 1 ]] && { printf '%s' "$body"; return 0; }
  # **JSON でなければ触らない**（`merged` のような素のテキストを返す handler が在る）。
  jq -e . >/dev/null 2>&1 <<<"$body" || { printf '%s' "$body"; return 0; }
  jq -c --argjson n "$FAKE_PER_PAGE" '
    if type == "array" then .[0:$n]
    elif type == "object" then
      with_entries(if (.value | type) == "array" then .value |= .[0:$n] else . end)
    else . end' <<<"$body" 2>/dev/null || printf '%s' "$body"
}

PAGINATED=0
for a in "$@"; do [[ "$a" == "--paginate" ]] && PAGINATED=1; done

set +e
out=$(handle_with_defaults "$@")
rc=$?
set -e
[[ -n "$out" ]] && out=$(paginate_emulate "$out" "$PAGINATED")
if [[ -z "$JQ" ]]; then
  [[ -n "$out" ]] && printf '%s\n' "$out"
  exit "$rc"
fi
[[ -n "$out" ]] && jq -r "$JQ" <<<"$out"
exit "$rc"
