   "speechId": "122104183X00220260409_005"
  },
  {
   "chars": 8,
   "date": "2026-04-09",
   "excerpt": "次に、國重徹君。",
   "kind": "speech",
   "meeting": "憲法審査会 第2号",
   "session": 221,
   "sourceUrl": "https://kokkai.ndl.go.jp/txt/122104183X00220260409/3",
