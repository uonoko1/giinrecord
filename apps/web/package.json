    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@react-router/node": "^7.18.0",
    "@seiji-kiroku/shared": "workspace:*",
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.0.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
