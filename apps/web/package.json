{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && tsx scripts/sitemap.ts && tsx scripts/build-archive.ts && tsx scripts/copy-member-data.ts",
    "preview": "vite preview --outDir build/client",
